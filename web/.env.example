NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Never expose this key in client-side code.
# FloodWatch uses SUPABASE_SECRET_KEY (not a Team Scheduler key).
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Google Sheets importer (server-only). Service-account JSON as a single line.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=
GOOGLE_SHEETS_TARGET_TABLE=flood_prone_areas
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SYNC_INTERVAL_MINUTES=5

# Vercel Cron sends Authorization: Bearer CRON_SECRET
CRON_SECRET=

# Optional OpenAI-compatible API for ambiguous normalization / duplicate reasons.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
