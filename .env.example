# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Apps Script backend (server-only — do NOT prefix with NEXT_PUBLIC_) ---
# The deployed Apps Script web app's /exec URL.
APPS_SCRIPT_URL=
# Shared secret the Apps Script web app checks on every request (Script
# Property API_KEY on the Apps Script side must match this exactly).
APPS_SCRIPT_API_KEY=

# --- Supabase secondary datastore (server-only) ---
SUPABASE_URL=
# service_role key — full access, server-only, NEVER exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication (NextAuth + Google Sign-In) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Geocoding pipeline admin trigger (server-only) ---
# Shared secret required (as `adminKey` query param or `x-admin-key` header)
# to call POST /api/admin/geocode. Not yet gated by real user auth — see
# CLAUDE.md §8.
GEOCODING_ADMIN_KEY=

# Optional. "photon" (default: Photon first, Nominatim fallback) or "nominatim" (Nominatim only).
GEOCODER=
